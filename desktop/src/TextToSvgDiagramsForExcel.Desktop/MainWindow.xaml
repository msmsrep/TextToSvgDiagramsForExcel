<Window x:Class="TextToSvgDiagramsForExcel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:TextToSvgDiagramsForExcel.Desktop.Resources"
        xmlns:vm="clr-namespace:TextToSvgDiagramsForExcel.Desktop.ViewModels"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{res:Loc AppTitle}"
        Icon="Assets/icon.ico"
        Width="960" Height="640" MinWidth="560" MinHeight="400"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="TemplateItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="Command" Value="{Binding DataContext.TemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding Id}" />
        </Style>
        <Style x:Key="OptionItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Label}" />
            <Setter Property="CommandParameter" Value="{Binding Value}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{res:Loc Menu_File}">
                <MenuItem Header="{res:Loc Menu_OpenMmd}" Command="{Binding OpenMmdCommand}" />
                <MenuItem Header="{res:Loc Menu_SaveMmd}" Command="{Binding SaveMmdCommand}" />
                <Separator />
                <MenuItem Header="{res:Loc Menu_Exit}" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="{res:Loc Menu_New}">
                <MenuItem Header="{res:Loc Menu_Template}" ItemsSource="{Binding Templates}" ItemContainerStyle="{StaticResource TemplateItem}" />
                <MenuItem Header="{res:Loc Menu_FromCells}" ItemsSource="{Binding TableKinds}" IsEnabled="{Binding IsExcelConnected}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource OptionItem}">
                            <Setter Property="Command" Value="{Binding DataContext.FromCellsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{res:Loc Menu_Output}">
                <MenuItem Header="{res:Loc Menu_InsertAs}" ItemsSource="{Binding Formats}" IsEnabled="{Binding IsExcelConnected}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource OptionItem}">
                            <Setter Property="Command" Value="{Binding DataContext.InsertAsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="{res:Loc Menu_SaveAs}" ItemsSource="{Binding SaveFormats}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource OptionItem}">
                            <Setter Property="Command" Value="{Binding DataContext.SaveAsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="{res:Loc Menu_Copy}" Command="{Binding CopyCommand}" InputGestureText="Ctrl+Shift+C" />
                <Separator />
                <MenuItem Header="{res:Loc Menu_LoadSelected}" Command="{Binding LoadSelectedCommand}" IsEnabled="{Binding IsExcelConnected}" />
            </MenuItem>
            <MenuItem Header="{res:Loc Menu_View}">
                <MenuItem x:Name="AlwaysOnTopItem" Header="{res:Loc Menu_AlwaysOnTop}" IsCheckable="True" Click="OnAlwaysOnTopClick" />
                <MenuItem Header="{res:Loc Menu_AutoDetect}" IsCheckable="True" IsChecked="{Binding AutoDetectSelection}" />
                <MenuItem x:Name="LanguageMenu" Header="{res:Loc Menu_Language}">
                    <MenuItem Header="{res:Loc Lang_System}" Tag="system" IsCheckable="True" Click="OnLanguageClick" />
                    <MenuItem Header="English" Tag="en" IsCheckable="True" Click="OnLanguageClick" />
                    <MenuItem Header="日本語" Tag="ja" IsCheckable="True" Click="OnLanguageClick" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Diagram selection and the Excel connection -->
        <Grid DockPanel.Dock="Top" Margin="8,6,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{res:Loc Label_Diagram}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="DiagramSelect" Grid.Column="1" ItemsSource="{Binding DiagramOptions}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" DropDownOpened="OnDiagramDropDownOpened" SelectionChanged="OnDiagramSelectionChanged"
                      IsEnabled="{Binding IsExcelFound}" AutomationProperties.Name="{res:Loc Label_Diagram}" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}"
                    ToolTip="{res:Loc Tooltip_Refresh}" AutomationProperties.Name="{res:Loc Tooltip_Refresh}" />
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8E5;" Command="{Binding LoadSelectedCommand}"
                    IsEnabled="{Binding IsExcelConnected}" ToolTip="{res:Loc Tooltip_LoadSelected}" AutomationProperties.Name="{res:Loc Tooltip_LoadSelected}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#B0B0B0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExcelConnected}" Value="True">
                                    <Setter Property="Fill" Value="#2E9E4F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ExcelStatusText}" TextTrimming="CharacterEllipsis" Foreground="#555555" />
            </StackPanel>
        </Grid>

        <!-- Load confirmation (unsaved code would be replaced) -->
        <Border DockPanel.Dock="Top" Margin="8,0,8,6" Padding="8,6" Background="#FFF4CE" BorderBrush="#E8C66B" BorderThickness="1"
                Visibility="{Binding ConfirmVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{res:Loc Button_Replace}" Command="{Binding ReplaceCommand}" Padding="12,2" Margin="8,0,0,0" />
                    <Button Content="{res:Loc Button_Keep}" Command="{Binding KeepCommand}" Padding="12,2" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Output settings -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,6">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <TextBlock Text="{res:Loc Label_Size}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="96" ItemsSource="{Binding Sizes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Size}" IsEnabled="{Binding SizeEnabled}" AutomationProperties.Name="{res:Loc Label_Size}" />
                    <TextBox Width="64" Margin="6,0,0,0" VerticalContentAlignment="Center" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding WidthVisible, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding SizeEnabled}"
                             AutomationProperties.Name="{res:Loc SizeWidth}" />
                    <CheckBox Content="{res:Loc KeepCurrentSize}" Margin="10,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding KeepCurrentSize}" IsEnabled="{Binding KeepSizeEnabled}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="{res:Loc Label_Format}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox MinWidth="170" ItemsSource="{Binding Formats}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Format}" AutomationProperties.Name="{res:Loc Label_Format}" />
                    <Button Content="{res:Loc Button_Insert}" Command="{Binding InsertCommand}" Margin="8,0,0,0" Padding="14,3" IsDefault="False" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Command="{Binding SaveCommand}"
                            ToolTip="{res:Loc Tooltip_Save}" AutomationProperties.Name="{res:Loc Tooltip_Save}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Command="{Binding CopyCommand}"
                            ToolTip="{res:Loc Tooltip_Copy}" AutomationProperties.Name="{res:Loc Tooltip_Copy}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Errors -->
        <DockPanel DockPanel.Dock="Bottom" Margin="8,2,8,4">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorLine}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Hyperlink Command="{Binding GoToErrorLineCommand}"><Run Text="{Binding GoToLineText, Mode=OneWay}" /></Hyperlink>
            </TextBlock>
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#C42B1C" MaxHeight="80" />
        </DockPanel>

        <!-- Editor and preview, side by side (stacked when the window is tall) -->
        <Grid x:Name="WorkArea" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="2*" MinWidth="120" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="3*" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="EditorRow" Height="*" />
                <RowDefinition x:Name="SplitterRow" Height="0" />
                <RowDefinition x:Name="PreviewRow" Height="0" />
            </Grid.RowDefinitions>
            <Border x:Name="EditorBorder" BorderBrush="#CCCCCC" BorderThickness="1">
                <avalon:TextEditor x:Name="Editor" FontFamily="Consolas, Cascadia Mono, MS Gothic" FontSize="13"
                                   ShowLineNumbers="True" WordWrap="False" HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Mermaid code" />
            </Border>
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragCompleted" />
            <Border x:Name="PreviewBorder" Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1">
                <wv2:WebView2 x:Name="Preview" DefaultBackgroundColor="White" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
