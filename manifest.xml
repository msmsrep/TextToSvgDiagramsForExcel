      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="OpenPane.Description" DefaultValue="Open the pane to write Mermaid code, preview the diagram and insert it into the sheet"/>
        <bt:String id="Template.flowchart.Description" DefaultValue="Put a Flowchart example in the editor"/>
        <bt:String id="Template.sequence.Description" DefaultValue="Put a Sequence example in the editor"/>
        <bt:String id="Template.class.Description" DefaultValue="Put a Class example in the editor"/>
        <bt:String id="Template.state.Description" DefaultValue="Put a State example in the editor"/>
