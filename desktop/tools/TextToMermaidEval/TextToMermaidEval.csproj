<Project Sdk="Microsoft.NET.Sdk">

  <!-- Measures text-to-Mermaid on cases.ja.json: the rule-based conversion and,
       with a model folder, the local model. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TextToSvgDiagramsForExcel.Generation\TextToSvgDiagramsForExcel.Generation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="cases.ja.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
