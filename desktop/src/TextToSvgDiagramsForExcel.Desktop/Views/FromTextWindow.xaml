<Window x:Class="TextToSvgDiagramsForExcel.Desktop.Views.FromTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:TextToSvgDiagramsForExcel.Desktop.Resources"
        Title="{res:Loc FromText_Title}"
        Width="560" Height="420" MinWidth="360" MinHeight="280"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Hint" Text="{res:Loc FromText_Hint}" TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,8" />
        <TextBox x:Name="Input" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Meiryo UI"
                 TextChanged="OnTextChanged" AutomationProperties.Name="{res:Loc FromText_Title}" />
        <!-- Shown while the local model works, or with its error. -->
        <DockPanel x:Name="StatusPanel" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="Progress" DockPanel.Dock="Left" Width="80" Height="6" IsIndeterminate="True"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock Text="{res:Loc FromText_Kind}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="KindSelect" MinWidth="120" DisplayMemberPath="Label" SelectedValuePath="Value"
                      AutomationProperties.Name="{res:Loc FromText_Kind}" />
            <CheckBox x:Name="UseAiCheck" Content="{res:Loc FromText_UseAi}" VerticalAlignment="Center" Margin="12,0,0,0"
                      Visibility="Collapsed" Checked="OnUseAiChanged" Unchecked="OnUseAiChanged" />
            <Button DockPanel.Dock="Right" Content="{res:Loc Button_Cancel}" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
            <Button x:Name="CreateButton" DockPanel.Dock="Right" Content="{res:Loc Button_Create}" Click="OnCreateClick" MinWidth="80" />
        </DockPanel>
    </Grid>
</Window>
