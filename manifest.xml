        <bt:String id="Template.mindmap.Label" DefaultValue="Mindmap"/>
        <bt:String id="Template.timeline.Label" DefaultValue="Timeline"/>
        <bt:String id="Template.Label" DefaultValue="Template"/>
        <bt:String id="Cells.auto.Label" DefaultValue="Auto"/>
        <bt:String id="Cells.flowchart.Label" DefaultValue="Flowchart"/>
        <bt:String id="Cells.gantt.Label" DefaultValue="Gantt"/>
        <bt:String id="Cells.pie.Label" DefaultValue="Pie"/>
        <bt:String id="Cells.Label" DefaultValue="From cells"/>
        <bt:String id="Group.New.Label" DefaultValue="New"/>
        <bt:String id="Insert.png.Label" DefaultValue="PNG"/>
        <bt:String id="Insert.jpeg.Label" DefaultValue="JPEG"/>
        <bt:String id="Insert.svg.Label" DefaultValue="SVG"/>
