<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>TextToSvgDiagramsForExcel.Desktop.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TextToSvgDiagramsForExcel.Desktop\TextToSvgDiagramsForExcel.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Fixtures shared with the TypeScript tests, and the resources whose keys are compared. -->
    <None Include="..\..\..\test\fixtures\**" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\TextToSvgDiagramsForExcel.Desktop\Resources\*.resx" LinkBase="resx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
