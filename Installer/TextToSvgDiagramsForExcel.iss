; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "Text-to-SVG Diagrams for Excel"
#define MyAppVersion "1.4.0.0"
#define MyAppPublisher "msmsrep"
#define MyAppURL "https://github.com/msmsrep/TextToSvgDiagramsForExcel"
#define MyManifestName "manifest.xml"
; フォルダ名・共有名・出力ファイル名に使う（空白と記号を含めない）
#define MyDirName "TextToSvgDiagramsForExcel"
#define MyShareName "TextToSvgDiagramsForExcel"
; 旧名（Mermaid for Excel）の配置先と共有名。上書きインストール時に削除する
#define MyOldDirName "MermaidForExcel"
#define MyOldShareName "MermaidForExcel"
; パスは""ではなく''で囲む
#define MyAppPath '..\dist\'

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{b03396e2-ce16-4a36-8871-8ba5ae18c7de}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
; AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}/issues
AppUpdatesURL={#MyAppURL}
; プログラムフォルダ
; DefaultDirName={autopf}\App\{#MyAppName}

; マイドキュメント
; userdocsはonedriveフォルダにリダイレクトされる
; DefaultDirName={userdocs}\App\OfficeAddIns\Excel\{#MyAppName}
; 非管理者で実行するため、ログオン中のユーザーのプロファイル配下になる
DefaultDirName={%USERPROFILE}\Documents\OfficeAddIns\Excel\{#MyDirName}
; AppId が旧名の版と同じため、前回の配置先（旧名のフォルダ）を引き継がないようにする
UsePreviousAppDir=no

; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
; ログオン中のユーザーとして実行する（HKCU とプロファイルを実ユーザーのものにするため）。
; 管理者権限が必要な SMB 共有の作成・削除だけを個別に昇格して実行する。
PrivilegesRequired=lowest
; HKCU への登録は意図的（Office の TrustedCatalogs はユーザー単位）
UsedUserAreasWarning=no
OutputDir=.
OutputBaseFilename={#MyDirName}Setup
; SetupIconFile={#MyAppPath}logo_red.ico
SolidCompression=yes
VersionInfoVersion={#MyAppVersion}
WizardStyle=modern
; 始めの画面にメッセージをだす
; InfoBeforeFile=InfoBefore.txt


[Languages]
Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl"

[Tasks]
; Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}";
; Name: "startupicon"; Description: "スタートアップにショートカットを作成";

[Files]
; xmlを配布
Source: "{#MyAppPath}{#MyManifestName}"; DestDir: "{app}"; Flags: ignoreversion
; フォルダをまとめて指定する場合
; Source: "{#MyAppPath}*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files


; 参考 https://learn.microsoft.com/ja-jp/office/dev/add-ins/testing/create-a-network-shared-folder-catalog-for-task-pane-and-content-add-ins
; レジストリのGUIDとinno setup（AppId）でのGUIDは別。
; 旧名の版と同じ GUID のため、上書きインストールでカタログの Url が新しい共有名に置き換わる。
[Registry]
Root: HKCU; Subkey: "Software\Microsoft\Office\16.0\WEF\TrustedCatalogs\{{0e1e7db9-24b4-4064-8d0c-995f6f80a03f}}"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Microsoft\Office\16.0\WEF\TrustedCatalogs\{{0e1e7db9-24b4-4064-8d0c-995f6f80a03f}}"; ValueType: string; ValueName: "Id"; ValueData: "{{0e1e7db9-24b4-4064-8d0c-995f6f80a03f}}"
Root: HKCU; Subkey: "Software\Microsoft\Office\16.0\WEF\TrustedCatalogs\{{0e1e7db9-24b4-4064-8d0c-995f6f80a03f}}"; ValueType: string; ValueName: "Url"; ValueData: "\\{computername}\{#MyShareName}"
Root: HKCU; Subkey: "Software\Microsoft\Office\16.0\WEF\TrustedCatalogs\{{0e1e7db9-24b4-4064-8d0c-995f6f80a03f}}"; ValueType: dword; ValueName: "Flags"; ValueData: 1

[Icons]
; Name: "{autoprograms}\App\{#MyAppName}"; Filename: "{app}\{#MyManifestName}"
; Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyManifestName}"; Tasks: desktopicon
; Name: "{userstartup}\{#MyAppName}"; Filename: "{app}\{#MyManifestName}"; Tasks: startupicon

[Run]

[UninstallRun]


[Code]
{ net share を UAC で昇格して実行する。Commands は cmd /c に渡すコマンド列。
  ShellExec は終了コードを返さないため、結果は呼び出し側で ShareExists により確認する }
procedure ExecNetShareElevated(const Commands: string);
var
	ErrorCode: Integer;
begin
	ShellExec(
		'runas',
		ExpandConstant('{cmd}'),
		'/c ' + Commands,
		'',
		SW_HIDE,
		ewWaitUntilTerminated,
		ErrorCode
	);
end;

{ 共有の参照。net share <名前> は管理者権限がないとアクセス拒否（エラー 5）になるため、
  UNC パスとして参照できるかで判定する }
function ShareExists(const Name: string): Boolean;
begin
	Result := DirExists(ExpandConstant('\\{computername}\') + Name);
end;

function CatalogShareExists: Boolean;
begin
	Result := ShareExists('{#MyShareName}');
end;

{ 旧名の版の配置先から、旧版が置いたファイルだけを削除する }
procedure RemoveOldAppDir;
var
	OldDir: string;
begin
	OldDir := ExpandConstant('{%USERPROFILE}\Documents\OfficeAddIns\Excel\{#MyOldDirName}');
	if CompareText(OldDir, ExpandConstant('{app}')) = 0 then
		Exit;
	DeleteFile(OldDir + '\{#MyManifestName}');
	DeleteFile(OldDir + '\unins000.exe');
	DeleteFile(OldDir + '\unins000.dat');
	RemoveDir(OldDir);
end;

procedure EnsureCatalogShare;
var
	Commands: string;
begin
	{ 旧名の共有の削除と新しい共有の作成を、1 回の UAC 確認でまとめて行う }
	Commands := '';
	if ShareExists('{#MyOldShareName}') then
		Commands := 'net share {#MyOldShareName} /delete /y & ';
	if not CatalogShareExists then
		Commands := Commands + 'net share {#MyShareName}="' + ExpandConstant('{app}') + '"';
	if Commands = '' then
		Exit;

	ExecNetShareElevated(Commands);
	if not CatalogShareExists then
	begin
		MsgBox(
			'共有フォルダ "{#MyShareName}" の作成に失敗しました。' + #13#10 +
			'管理者権限の確認で [はい] を選択して、再度セットアップを実行してください。',
			mbError,
			MB_OK
		);
	end;
end;

procedure RemoveCatalogShare;
begin
	if CatalogShareExists then
		ExecNetShareElevated('net share {#MyShareName} /delete /y');
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
	if CurStep = ssPostInstall then
	begin
		EnsureCatalogShare;
		RemoveOldAppDir;
	end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
	if CurUninstallStep = usUninstall then
		RemoveCatalogShare;
end;
